---
import { languageUrl, localeFromUrl } from '../lib/i18n';
const locale = localeFromUrl(Astro.url);
---
<details class="language-select">
  <summary id="language-select" class="btn btn-sm language-trigger" aria-label="Language / Язык">
    <span>{locale === 'ru' ? 'РУ' : 'EN'}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
  </summary>
  <nav class="language-options" aria-label="Language / Язык">
    {(['en', 'ru'] as const).map((language) => (
      <a href={languageUrl(Astro.url, language).pathname} data-locale={language} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>
        {language === 'ru' ? 'Русский' : 'English'}
        <svg class="language-check" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
      </a>
    ))}
  </nav>
</details>

<script>
  import { languageUrl } from '../lib/i18n';
  const root = document.querySelector<HTMLDetailsElement>('.language-select')!;
  const trigger = root.querySelector<HTMLElement>('summary')!;
  const options = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-locale]'));
  function refreshLinks() {
    options.forEach((option) => {
      option.href = languageUrl(new URL(location.href), option.dataset.locale === 'ru' ? 'ru' : 'en').href;
    });
  }
  refreshLinks();
  root.addEventListener('toggle', refreshLinks);
  root.addEventListener('pointerdown', refreshLinks);
  root.addEventListener('focusin', refreshLinks);
  window.addEventListener('popstate', refreshLinks);
  window.addEventListener('pageshow', () => { root.open = false; refreshLinks(); });
  root.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root.open) {
      event.preventDefault();
      root.open = false;
      trigger.focus();
    }
  });
  root.addEventListener('focusout', (event) => {
    if (event.relatedTarget && !root.contains(event.relatedTarget as Node)) root.open = false;
  });
  document.addEventListener('click', (event) => {
    if (!root.contains(event.target as Node)) root.open = false;
  });
</script>
