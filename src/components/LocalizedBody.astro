---
import { renderTranslation } from '../lib/render-translation';

interface Props {
  ru?: string;
}
const { ru } = Astro.props;
const html = ru?.trim() ? await renderTranslation(ru) : undefined;
---
<div lang="en" data-content-body={html ? 'en' : undefined}><slot /></div>
{html && <div lang="ru" data-content-body="ru" hidden set:html={html} />}
