---
import { localeFromUrl } from '../lib/i18n';
import { renderTranslation } from '../lib/render-translation';

interface Props {
  ru?: string;
}
const { ru } = Astro.props;
const html = localeFromUrl(Astro.url) === 'ru' && ru?.trim() ? await renderTranslation(ru) : undefined;
---
{html ? <div lang="ru" set:html={html} /> : <div lang="en"><slot /></div>}
