---
import { localeFromUrl } from '../lib/i18n';
import { contentText, contentLanguage } from '../lib/content-language';
interface Props {
  en: string;
  ru?: string;
}
const { en, ru } = Astro.props;
const locale = localeFromUrl(Astro.url);
---
<span lang={contentLanguage(ru, locale)}>{contentText(en, ru, locale)}</span>
