---
import KineticLogo from './KineticLogo.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.tsx';

interface Props {
  active?: 'home' | 'blog' | 'pubs' | 'about';
}

const { active } = Astro.props;
const path = Astro.url.pathname;
const isActive = (route: string) => {
  if (route === '/') return path === '/' || active === 'home';
  return path.startsWith(route);
};
---

<header class="site-header">
  <div class="container nav">
    <KineticLogo size="28px" className="brand" transitionName="brand-title" />
    <div class="nav-spacer"></div>
    <nav class="nav-links" aria-label="Primary" data-i18n-aria-label="Primary">
      <a href="/" data-astro-prefetch class={isActive('/') ? 'active' : ''} data-i18n="Home">Home</a>
      <a href="/blog" data-astro-prefetch class={isActive('/blog') ? 'active' : ''} data-i18n="Blog">Blog</a>
      <a href="/publications" data-astro-prefetch class={isActive('/publications') ? 'active' : ''} data-i18n="Publications">Publications</a>
      <a href="/about" data-astro-prefetch class={isActive('/about') ? 'active' : ''} data-i18n="About">About</a>
    </nav>
    <div class="nav-spacer"></div>
    <div class="nav-tools">
      <ThemeToggle />
      <LanguageSelect />
      <a class="btn btn-sm desktop-only" href="/#join" data-i18n="Contact">Contact</a>
      <MobileNav client:load active={path === '/' ? '/' : '/' + path.split('/')[1]} />
    </div>
  </div>
</header>
