---
import { localeFromUrl, translate, localizedHref } from '../lib/i18n';
import KineticLogo from './KineticLogo.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.tsx';

interface Props {
  active?: 'home' | 'blog' | 'pubs' | 'about';
}

const { active } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(?:en|ru)(?=\/|$)/, '') || '/';
const isActive = (route: string) => {
  if (route === '/') return path === '/' || active === 'home';
  return path.startsWith(route);
};
const locale = localeFromUrl(Astro.url);
---

<header class="site-header">
  <div class="container nav">
    <KineticLogo size="28px" className="brand" transitionName="brand-title" />
    <div class="nav-spacer"></div>
    <nav class="nav-links" aria-label={translate('Primary', locale)}>
      <a href={localizedHref('/', locale)} data-astro-prefetch class={isActive('/') ? 'active' : ''}>{translate('Home', locale)}</a>
      <a href={localizedHref('/blog', locale)} data-astro-prefetch class={isActive('/blog') ? 'active' : ''}>{translate('Blog', locale)}</a>
      <a href={localizedHref('/publications', locale)} data-astro-prefetch class={isActive('/publications') ? 'active' : ''}>{translate('Publications', locale)}</a>
      <a href={localizedHref('/about', locale)} data-astro-prefetch class={isActive('/about') ? 'active' : ''}>{translate('About', locale)}</a>
    </nav>
    <div class="nav-spacer"></div>
    <div class="nav-tools">
      <ThemeToggle />
      <LanguageSelect />
      <a class="btn btn-sm desktop-only" href={localizedHref('/#join', locale)}>{translate('Contact', locale)}</a>
      <MobileNav initialLocale={locale} client:load active={path === '/' ? '/' : '/' + path.split('/')[1]} />
    </div>
  </div>
</header>
