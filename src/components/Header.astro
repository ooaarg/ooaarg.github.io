---
import { localeFromUrl, translate, localizedHref } from '../lib/i18n';
import KineticLogo from './KineticLogo.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.tsx';

interface Props {
  active?: 'home' | 'blog' | 'pubs' | 'about';
}

const { active } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(?:en|ru)(?=\/|$)/, '') || '/';
const isActive = (route: string) => {
  if (route === '/') return path === '/' || active === 'home';
  return path.startsWith(route);
};
const locale = localeFromUrl(Astro.url);
---

<header class="site-header">
  <div class="container nav">
    <div class="brand-disclosure">
      <KineticLogo size="clamp(28px, calc(10vw - 4px), 32px)" className="brand" transitionName="brand-title" descriptionId="brand-expansion" />
      <div class="brand-tooltip" id="brand-expansion" role="tooltip" lang="en">
        Online Optimization and Applications Research Group
      </div>
    </div>
    <div class="nav-spacer"></div>
    <nav class="nav-links" aria-label={translate('Primary', locale)}>
      <a href={localizedHref('/', locale)} data-astro-prefetch class={isActive('/') ? 'active' : ''} aria-current={isActive('/') ? 'page' : undefined}>{translate('Home', locale)}</a>
      <a href={localizedHref('/blog', locale)} data-astro-prefetch class={isActive('/blog') ? 'active' : ''} aria-current={isActive('/blog') ? 'page' : undefined}>{translate('Blog', locale)}</a>
      <a href={localizedHref('/publications', locale)} data-astro-prefetch class={isActive('/publications') ? 'active' : ''} aria-current={isActive('/publications') ? 'page' : undefined}>{translate('Publications', locale)}</a>
      <a href={localizedHref('/about', locale)} data-astro-prefetch class={isActive('/about') ? 'active' : ''} aria-current={isActive('/about') ? 'page' : undefined}>{translate('About', locale)}</a>
    </nav>
    <div class="nav-spacer"></div>
    <div class="nav-tools">
      <ThemeToggle />
      <div class="header-actions">
        <LanguageSelect />
        <a class="btn btn-primary header-contact desktop-only" href={localizedHref('/#join', locale)}>{translate('Contact', locale)}</a>
      </div>
      <MobileNav initialLocale={locale} client:load active={path === '/' ? '/' : '/' + path.split('/')[1]} />
    </div>
  </div>
</header>

<script>
  const brand = document.querySelector<HTMLElement>('.brand-disclosure');
  const updateBrandPosition = () => {
    brand?.toggleAttribute('data-at-top', window.scrollY <= 0);
  };
  updateBrandPosition();
  window.addEventListener('scroll', updateBrandPosition, { passive: true });
  window.addEventListener('pageshow', updateBrandPosition);
  brand?.addEventListener('pointerleave', () => { delete brand.dataset.dismissed; });
  brand?.addEventListener('focusout', () => { delete brand.dataset.dismissed; });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && brand && (brand.matches(':hover') || brand.contains(document.activeElement))) {
      brand.dataset.dismissed = 'true';
    }
  });
  document.addEventListener('pointerdown', () => {
    document.documentElement.dataset.focusInput = 'pointer';
  }, { capture: true });
  // Escape closes a surface without changing how focus should be shown.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') return;
    document.documentElement.dataset.focusInput = 'keyboard';
    document.querySelectorAll<HTMLElement>('.nav-tools [data-pointer-focus]').forEach((control) => {
      delete control.dataset.pointerFocus;
    });
  }, { capture: true });
</script>
