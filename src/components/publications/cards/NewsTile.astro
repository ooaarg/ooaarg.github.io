---
import { localeFromUrl, translate, localizedHref } from '../../../lib/i18n';
import { contentText } from '../../../lib/content-language';
import LocalizedText from '../../LocalizedText.astro';
import LocalizedDate from '../../LocalizedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  item: CollectionEntry<'news'>;
  span?: 2 | 3 | 4 | 6;
}

const { item, span: spanOverride } = Astro.props;
const { data, id } = item;
const year = data.date.getFullYear();
const span = spanOverride ?? data.span ?? 3;
const detailHref = `/blog/${id}`;
const locale = localeFromUrl(Astro.url);
---

<article class={`bento-tile span-${span} news-tile`} data-year={year}>
  {data.image && (
    <div class="figure news-figure">
      <Image src={data.image} alt={contentText(data.imageAlt, data.ru?.imageAlt, locale)} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="meta">
    <span class="pill accent"><span>{translate('News', locale)}</span></span>
    <span style="margin-left: 8px;"><LocalizedDate date={data.date} /></span>
  </div>
  <h3>
    <a href={localizedHref(detailHref, locale)} style="color: inherit; text-decoration: none;"><LocalizedText en={data.title} ru={data.ru?.title} /></a>
  </h3>
  <p style="color: var(--fg-muted); font-size: 14px;"><LocalizedText en={data.summary} ru={data.ru?.summary} /></p>
  <div class="actions">
    {data.href && (
      <a class="btn btn-sm" href={data.href} target="_blank" rel="noopener">{translate('Conference', locale)}</a>
    )}
    <a class="btn btn-sm btn-ghost" href={localizedHref(detailHref, locale)}><span>{translate('Read', locale)}</span><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M5 12H19M12 19L19 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg></a>
  </div>
</article>

<style>
  .news-figure {
    background: var(--bg-sunken);
  }
  .news-tile .figure {
    height: 300px;
  }
  .news-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
  }
  @media (max-width: 640px) {
    .news-tile .figure {
      height: 220px;
    }
  }
</style>
