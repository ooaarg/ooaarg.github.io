---
import { localeFromUrl, translate, localizedHref } from '../../../lib/i18n';
import LocalizedText from '../../LocalizedText.astro';
import type { CollectionEntry } from 'astro:content';
import PaperFigure, { hasPaperFigure } from '../detail/PaperFigure.tsx';
import CiteButton from '../shared/CiteButton.tsx';
import { getAuthorMap, resolveAuthors } from '../../../lib/people';
import { paperUrl, doiOf, extraLinks } from '../../../lib/pubs';

interface Props {
  pub: CollectionEntry<'publications'>;
  /** Override `pub.data.span` — used by the publications page to expand
   *  tiles that would otherwise sit alone on a row, so the bento has no gaps. */
  span?: 2 | 3 | 4 | 6;
}

const { pub, span: spanOverride } = Astro.props;
const { data, id } = pub;
const year = data.date.getFullYear();
const span = spanOverride ?? data.span ?? 2;
const featured = data.featured;
const detailHref = `/publications/${id}`;
/* Figure presence is decoupled from `featured`: any paper with a matching
 * figure component (figures/<area>/<id>.tsx) renders it on the bento tile.
 * `featured` only controls visual prominence (padding, typography). */
const showFigure = hasPaperFigure(id);
const paper = paperUrl(data);
const extra = extraLinks(data);
const authorMap = await getAuthorMap();
const authorEntries = resolveAuthors(data.authors, authorMap, data.ru?.authors);
const citable = {
  id,
  title: data.title,
  authors: data.authors,
  dateISO: data.date.toISOString(),
  venue: data.venue,
  type: data.type,
  tag: data.tag,
  arxiv: data.arxiv,
  doi: doiOf(data),
};
const locale = localeFromUrl(Astro.url);
---

<article class={`bento-tile span-${span}${featured ? ' feature' : ''}`} data-year={year}>
  {showFigure && (
    <div class="figure">
      <PaperFigure id={id} />
    </div>
  )}
  <div class="meta">
    <span class={`pill${featured ? ' accent' : ''}`}>{translate(data.tag, locale)}</span>
    <span style="margin-left: 8px;"><LocalizedText en={data.venue} ru={data.ru?.venue} /> · {year}</span>
  </div>
  <h3>
    <a href={localizedHref(detailHref, locale)} style="color: inherit; text-decoration: none;"><LocalizedText en={data.title} ru={data.ru?.title} /></a>
  </h3>
  <p style={`color: var(--fg-muted); font-size: ${featured ? 14 : 13}px;`}>
    {featured ? <LocalizedText en={data.summary} ru={data.ru?.summary} /> : authorEntries.map((a, i) => (
      <>
        {a.id ? <a class="author-link" href={localizedHref(`/about/${a.id}`, locale)}><LocalizedText en={a.name} ru={a.ru} /></a> : <LocalizedText en={a.name} ru={a.ru} />}
        {i < authorEntries.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>
  {featured && (
    <p style="font-size: 13px; color: var(--fg-muted);">
      {authorEntries.map((a, i) => (
        <>
          {a.id ? <a class="author-link" href={localizedHref(`/about/${a.id}`, locale)}><LocalizedText en={a.name} ru={a.ru} /></a> : <LocalizedText en={a.name} ru={a.ru} />}
          {i < authorEntries.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
  )}
  <div class="actions">
    {paper ? (
      <a class="btn btn-sm" href={paper} target="_blank" rel="noopener">{translate('Paper', locale)}</a>
    ) : data.arxiv ? (
      <a class="btn btn-sm" href={`https://arxiv.org/abs/${data.arxiv}`} target="_blank" rel="noopener">arXiv</a>
    ) : extra.length > 0 ? (
      <a class="btn btn-sm" href={extra[0].url} target="_blank" rel="noopener"><LocalizedText en={extra[0].label} ru={data.ru?.links?.[extra[0].label]} /></a>
    ) : null}
    {data.github && (
      <a class="btn btn-sm" href={data.github} target="_blank" rel="noopener">GitHub</a>
    )}
    <CiteButton initialLocale={locale} client:visible pub={citable} />
    <a class="btn btn-sm btn-ghost" href={localizedHref(detailHref, locale)}><span>{translate('Read', locale)}</span><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M5 12H19M12 19L19 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg></a>
  </div>
</article>
