---
import { localeFromUrl, translate, localizedHref } from '../lib/i18n';
import KineticLogo from './KineticLogo.astro';
import groupSymbol from '../assets/ooaarg-symbol.svg?raw';

const locale = localeFromUrl(Astro.url);
const footerSymbol = groupSymbol.replaceAll('id="mark-sweep-', 'id="footer-mark-sweep-');
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="foot-wordmark">
          <span class="foot-symbol" data-symbol-spin aria-hidden="true" set:html={footerSymbol} />
          <KineticLogo size="28px" />
        </div>
        <p style="max-width: 32ch; color: var(--fg-muted);">{translate('Online Optimization And Applications Research Group.', locale)}</p>
      </div>
      <div>
        <h2 class="foot-label">{translate('Research', locale)}</h2>
        <ul>
          <li><a href={localizedHref('/blog', locale)}>{translate('Blog', locale)}</a></li>
          <li><a href={localizedHref('/publications', locale)}>{translate('Publications', locale)}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-label">{translate('Group', locale)}</h2>
        <ul>
          <li><a href={localizedHref('/about', locale)}>{translate('About', locale)}</a></li>
          <li><a href={localizedHref('/#join', locale)}>{translate('Join us', locale)}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-label">{translate('Elsewhere', locale)}</h2>
        <ul>
          <li><a href="https://github.com/ooaarg">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} <span>OOAARG</span> · <span>{translate('CC BY 4.0 unless noted', locale)}</span></span>
    </div>
  </div>
</footer>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const easing = getComputedStyle(document.documentElement).getPropertyValue('--ease-in-out').trim();

  document.querySelectorAll<HTMLElement>('[data-symbol-spin]').forEach((symbol) => {
    const svg = symbol.querySelector('svg');
    if (!svg) return;
    let rotation: Animation | undefined;
    symbol.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch' || !finePointer.matches || reducedMotion.matches || rotation?.playState === 'running') return;
      rotation = svg.animate(
        [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
        { duration: 700, easing },
      );
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) rotation?.cancel();
    });
  });
</script>
