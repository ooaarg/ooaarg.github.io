---
import LocalizedText from '../LocalizedText.astro';
import LocalizedDate from '../LocalizedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { AREAS, computeAreaStats } from '../../data/areas';

interface Props {
  pubs: CollectionEntry<'publications'>[];
}

const { pubs } = Astro.props;
const stats = computeAreaStats(pubs);
const tagTranslations = Object.assign({}, ...pubs.map((p) => p.data.ru?.tags ?? {})) as Record<string, string>;

---

<ul class="areas-grid">
  {AREAS.filter((area) => area.showOnHome !== false).map((area) => {
    const s = stats[area.id];
    const active = s.count > 0;

    return (
      <li>
      <a
        class={`area-card${active ? '' : ' is-nascent'}`}
        href={active ? `/publications?area=${area.id}` : '/publications'}
      >
        <div class="area-card-head">
          <h3 data-i18n={area.name}>{area.name}</h3>
          <span class="area-card-arrow" aria-hidden="true">→</span>
        </div>
        <p class="area-card-blurb" data-i18n={area.blurb}>{area.blurb}</p>

        {s.topTags.length > 0 && (
          <div class="area-card-tags">
            {s.topTags.map((t) => <span class="pill"><LocalizedText en={t} ru={tagTranslations[t]} /></span>)}
          </div>
        )}

        <div class="area-card-foot">
          {active ? (
            <>
              <span class="area-count"><span data-i18n="Papers:">Papers:</span> {s.count}</span>
              {s.latest && (
                <>
                  <span class="area-dot" aria-hidden="true">·</span>
                  <span class="area-latest mono"><span data-i18n="latest">latest</span> <LocalizedDate date={s.latest} precision="month" /></span>
                </>
              )}
            </>
          ) : (
            <span class="area-count area-nascent-label" data-i18n="In development">In development</span>
          )}
        </div>
      </a>
      </li>
    );
  })}
</ul>
