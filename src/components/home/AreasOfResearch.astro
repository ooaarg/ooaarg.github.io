---
import { localeFromUrl, translate, localizedHref } from '../../lib/i18n';
import type { CollectionEntry } from 'astro:content';
import { AREAS, computeAreaStats } from '../../data/areas';
interface Props { pubs: CollectionEntry<'publications'>[]; }
const { pubs } = Astro.props;
const stats = computeAreaStats(pubs);
const locale = localeFromUrl(Astro.url);
---
<ul class="areas-grid">
  {AREAS.filter(area => area.showOnHome !== false).map(area => {
    const count = stats[area.id].count;
    return <li><a class="area-card" href={localizedHref(count ? `/publications?area=${area.id}` : '/publications', locale)}>
      <h3>{translate(area.name, locale)}</h3>
      <p class="area-card-blurb">{translate(area.blurb, locale)}</p>
      <span class="area-card-action">
        {count ? `${translate('Publications', locale)}: ${count}` : translate('In development', locale)}
        <svg class="area-card-arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12H19M12 5L19 12L12 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </a></li>;
  })}
</ul>
