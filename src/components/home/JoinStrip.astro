---
import {localeFromUrl,translate,localizedHref} from '../../lib/i18n';
const locale=localeFromUrl(Astro.url);
---
<section id="join" class="section"><div class="container"><div class="collab-paths"><h2>{translate("Let's work together",locale)}</h2><div class="collab-path-grid">
<a class="collab-path" href={localizedHref('/about',locale)}><h3>{translate('Find an adviser',locale)}</h3><p>{locale==='ru'?'Познакомьтесь с участниками группы и их исследовательскими интересами.':'Meet the group and explore their research interests.'}</p><span class="collab-path-bottom">{locale==='ru'?'Участники группы':'Meet the group'} <svg class="collab-path-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12H19M12 19L19 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
<a class="collab-path" href="mailto:dornyv@my.msu.ru?subject=Industry%20partnership%20inquiry"><h3>{translate('Industry partnerships',locale)}</h3><p>{locale==='ru'?'Расскажите о задаче, которую хотите исследовать вместе с нами.':'Tell us about a problem you would like to research with us.'}</p><span class="collab-path-bottom">{locale==='ru'?'Написать нам':'Get in touch'} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M17 17V7H7M17 7L7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
</div></div></div></section>
