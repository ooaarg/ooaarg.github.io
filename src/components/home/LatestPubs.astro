---
import { getCollection } from 'astro:content';
import PublicationQuickView from '../publications/shared/PublicationQuickView.astro';
import { latestN } from '../../lib/pubs';
import { getAuthorMap, resolveAuthors } from '../../lib/people';

const all = await getCollection('publications');
const pubs = latestN(all, 4);
const authorMap = await getAuthorMap();

---

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 data-i18n="Out of the lab">Out of the lab</h2>
      </div>
    </div>

    <ul class="pub-list">
      {
        pubs.map((p) => (
          <PublicationQuickView publication={p} authors={resolveAuthors(p.data.authors, authorMap, p.data.ru?.authors)} />
        ))
      }
    </ul>

    <div style="margin-top: 32px; display: flex; justify-content: center;">
      <a class="btn" href="/publications" data-i18n="All publications →">All publications →</a>
    </div>
  </div>
</section>
