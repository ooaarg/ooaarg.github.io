---
import { localeFromUrl, translate, localizedHref } from '../../lib/i18n';
import { getCollection } from 'astro:content';
import PublicationQuickView from '../publications/shared/PublicationQuickView.astro';
import { latestN } from '../../lib/pubs';
import { getAuthorMap, resolveAuthors } from '../../lib/people';

const all = await getCollection('publications');
const pubs = latestN(all, 4);
const authorMap = await getAuthorMap();

const locale = localeFromUrl(Astro.url);
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>{translate('Out of the lab', locale)}</h2>
      </div>
    </div>

    <ul class="pub-list">
      {
        pubs.map((p) => (
          <PublicationQuickView minimalActions publication={p} authors={resolveAuthors(p.data.authors, authorMap, p.data.ru?.authors)} />
        ))
      }
    </ul>

    <a class="all-publications-link" href={localizedHref('/publications', locale)}>
      <span>{translate('All publications', locale)}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12H19M12 5L19 12L12 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>
</section>
