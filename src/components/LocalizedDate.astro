---
import { localeFromUrl } from '../lib/i18n';
import { formatDate } from '../lib/dates';

interface Props {
  date: Date | string;
  precision?: 'day' | 'month';
}
const { date, precision = 'day' } = Astro.props;
const iso = typeof date === 'string' ? date : date.toISOString();
---
<time datetime={iso}>{formatDate(iso, localeFromUrl(Astro.url), precision)}</time>
