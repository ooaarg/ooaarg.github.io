---
import { localeFromUrl, translate, localizedHref } from '../../lib/i18n';
import { contentText } from '../../lib/content-language';
import LocalizedBody from '../LocalizedBody.astro';
import LocalizedText from '../LocalizedText.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { data } = person;
const { Content } = await render(person);
const locale = localeFromUrl(Astro.url);
---

<div class="person-lead">
  <a class="person-lead-avatar" href={localizedHref(`/about/${person.id}`, locale)} aria-label={contentText(`View ${data.name}'s profile`, `Профиль: ${data.ru?.name ?? data.name}`, locale)}>
    <Avatar person={person} loading="eager" />
  </a>
  <div>
    <div class="role"><LocalizedText en={data.role} ru={data.ru?.role} /></div>
    <h3 class="person-lead-name"><LocalizedText en={data.name} ru={data.ru?.name} /></h3>
    <div style="font-size: 18px; color: var(--fg-muted); max-width: 56ch; margin-top: 16px;">
      <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody>
    </div>
    <!-- Outline SVGs: Rune Icons (Apache-2.0), https://github.com/Runeicons/runeicons -->
    <div class="person-lead-actions">
      <a class="btn btn-accent person-profile-link" href={localizedHref(`/about/${person.id}`, locale)}><span>{translate('View profile', locale)}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
<path d="M5 12H19M12 19L19 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg></a>
      {data.links.website && <a class="person-resource-link" href={data.links.website} target="_blank" rel="noopener">{translate('Website', locale)}</a>}
      {data.links.cv && <a class="person-resource-link" href={localizedHref(data.links.cv, locale)} target="_blank" rel="noopener">CV (PDF)</a>}
      {data.links.scholar && <a class="person-resource-link" href={localizedHref(data.links.scholar, locale)} target="_blank" rel="noopener"><span>Google Scholar</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
<path d="M17 17V7H7M17 7L7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg></a>}
      {data.links.dblp && <a class="person-resource-link" href={localizedHref(data.links.dblp, locale)} target="_blank" rel="noopener">DBLP</a>}
      {data.links.researchgate && <a class="person-resource-link" href={localizedHref(data.links.researchgate, locale)} target="_blank" rel="noopener">ResearchGate</a>}
      {data.email && <a class="person-resource-link person-email-link" href={localizedHref(`mailto:${data.email}`, locale)}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
<path d="M22 7L13.009 12.727C12.7039 12.9042 12.3573 12.9976 12.0045 12.9976C11.6517 12.9976 11.3051 12.9042 11 12.727L2 7M4 4H20C21.1046 4 22 4.89543 22 6V18C22 19.1046 21.1046 20 20 20H4C2.89543 20 2 19.1046 2 18V6C2 4.89543 2.89543 4 4 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg><span>{data.email}</span></a>}
    </div>
  </div>
</div>
