---
import LocalizedText from '../LocalizedText.astro';
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { data } = person;
---

<div class="person">
  <Avatar person={person} />
  <div>
    <div class="role"><LocalizedText en={data.role} ru={data.ru?.role} /></div>
    <h3 style="margin-top: 4px; font-family: var(--font-sans); font-size: 20px; font-weight: 550;"><LocalizedText en={data.name} ru={data.ru?.name} /></h3>
    <p class="topic" style="margin-top: 6px;"><LocalizedText en={data.topic} ru={data.ru?.topic} /></p>
  </div>
</div>
