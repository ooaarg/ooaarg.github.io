---
import { localeFromUrl, localizedHref, translate } from '../../lib/i18n';
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
const locale = localeFromUrl(Astro.url);
---

<a class="back-link" href={localizedHref(href, locale)}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M19 12H5M12 5L5 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span>{translate(label, locale)}</span>
</a>
