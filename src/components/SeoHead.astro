---
import { localeFromUrl, languageUrl } from '../lib/i18n';
import { contentText } from '../lib/content-language';
interface Props {
  title?: string;
  titleRu?: string;
  descriptionRu?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'OOAARG — Online Optimization And Applications Research Group',
  description = 'Online optimization, online learning, bandits, and DBMS optimization research at OOAARG.',
  canonical,
  titleRu,
  descriptionRu,
} = Astro.props;

const locale = localeFromUrl(Astro.url);
const canonicalUrl = canonical ?? languageUrl(new URL(Astro.url.pathname, Astro.site ?? 'https://ooaarg.github.io'), locale).href;
const localizedTitle = contentText(title, titleRu, locale);
const localizedDescription = contentText(description, descriptionRu, locale);
const canonicalBase = new URL(canonicalUrl);

---

<title>{localizedTitle}</title>
<meta name="description" content={localizedDescription} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:title" content={localizedTitle} />
<meta property="og:description" content={localizedDescription} />
<meta property="og:url" content={canonicalUrl} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={localizedTitle} />
<meta name="twitter:description" content={localizedDescription} />

<link rel="alternate" hreflang="en" href={languageUrl(canonicalBase, 'en').href} />
<link rel="alternate" hreflang="ru" href={languageUrl(canonicalBase, 'ru').href} />
<link rel="alternate" hreflang="x-default" href={languageUrl(canonicalBase, 'en').href} />
