---
import { getCollection, render } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import PaperFigure, { hasPaperFigure } from '../../components/publications/detail/PaperFigure.tsx';
import CiteButton from '../../components/publications/shared/CiteButton.tsx';
import { getAuthorMap, resolveAuthors } from '../../lib/people';
import { paperUrl, doiOf, extraLinks } from '../../lib/pubs';
import { citationKind } from '../../lib/bibtex';

import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({
    params: { id: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { data, id } = pub;
const { Content } = await render(pub);
const authorMap = await getAuthorMap();
const authorEntries = resolveAuthors(data.authors, authorMap);

const fmt = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;

const citable = {
  id,
  title: data.title,
  authors: data.authors,
  dateISO: data.date.toISOString(),
  venue: data.venue,
  type: data.type,
  tag: data.tag,
  arxiv: data.arxiv,
  doi: doiOf(data),
};

const showFigure = hasPaperFigure(id);
const paper = paperUrl(data);
const kind = citationKind(data);
const bibtexPath = `/publications/${id}.bib`;
---

<DetailLayout
  active="pubs"
  title={`${data.title} · OOAARG`}
  description={data.summary}
  heading={data.title}
>
  <Fragment slot="head">
    {data.type !== 'code' && data.type !== 'talk' && (
      <>
        <meta name="citation_title" content={data.title} />
        {data.authors.map((author) => <meta name="citation_author" content={author} />)}
        <meta name="citation_publication_date" content={data.date.toISOString().slice(0, 10).replaceAll('-', '/')} />
        {kind === 'article' && <meta name="citation_journal_title" content={data.venue} />}
        {kind === 'inproceedings' && <meta name="citation_conference_title" content={data.venue} />}
        {citable.doi && <meta name="citation_doi" content={citable.doi} />}
      </>
    )}
    <link rel="alternate" type="application/x-bibtex" href={bibtexPath} title="BibTeX citation" />
  </Fragment>

  <Fragment slot="breadcrumb">
    <a href="/publications">Publications</a> <span>/</span> <a href={`/publications?venue=${encodeURIComponent(data.venue)}`}>{data.venue}</a>{' '}<span>/</span>{' '}
    {data.authors[0].split(/\s+/).pop()} et al.
  </Fragment>

  <Fragment slot="badges">
    <span class="detail-type">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></svg>
      {data.type === 'paper' && data.tag === 'Preprint' ? 'Preprint' : data.type}
    </span>
  </Fragment>

  <p class="authors" slot="byline">
    {authorEntries.map((a, i) => (
      <>
        {a.id ? (
          <a class="author-link" href={`/about/${a.id}`}><strong>{a.name}</strong></a>
        ) : (
          <strong>{a.name}</strong>
        )}
        {i < authorEntries.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>

  <Fragment slot="actions">
    {paper && (
      <a class="btn btn-accent" href={paper} target="_blank" rel="noopener">Paper</a>
    )}
    {data.arxiv && (
      <a
        class={paper ? 'btn' : 'btn btn-primary'}
        href={`https://arxiv.org/abs/${data.arxiv}`}
        target="_blank"
        rel="noopener"
      >
        arXiv:{data.arxiv}
      </a>
    )}
    {data.pdf && <a class="btn" href={data.pdf} target="_blank" rel="noopener">PDF</a>}
    {data.github && <a class="btn" href={data.github} target="_blank" rel="noopener">GitHub</a>}
    {extraLinks(data).map((l) => (
      <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
    ))}
    <CiteButton client:visible pub={citable} size="md" label="Cite" />
    <a class="btn" href={bibtexPath} download={`${id}.bib`}><svg class="publication-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg>Download .bib</a>
  </Fragment>

  {showFigure && (
    <div class="pub-figure" slot="figure">
      <PaperFigure id={id} />
    </div>
  )}

  <Content />

  <Fragment slot="aside">
    <div class="group">
      <h2 class="aside-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 11h18" /></svg>Published</h2>
      <p class="mono" style="color: var(--fg);">{fmt(data.date)}</p>
    </div>
    <div class="group">
      <h2 class="aside-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-6 9 6H3Zm2 3v6m5-6v6m4-6v6m5-6v6M3 21h18M3 18h18" /></svg>Venue</h2>
      <p><a class="venue-link" href={`/publications?venue=${encodeURIComponent(data.venue)}`}>{data.venue}</a></p>
    </div>
    {data.tags.length > 0 && (
      <div class="group">
        <h2 class="aside-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h8l10 10-8 8L3 11V3Z" /><circle cx="7.5" cy="7.5" r="1" /></svg>Keywords</h2>
        <p class="publication-keywords">
          {data.tags.map((t, i) => (<><a href={`/publications?tag=${encodeURIComponent(t)}`}>{t}</a>{i < data.tags.length - 1 ? ", " : ""}</>))}
        </p>
      </div>
    )}
  </Fragment>
</DetailLayout>
