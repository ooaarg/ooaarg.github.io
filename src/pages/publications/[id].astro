---
import LocalizedBody from '../../components/LocalizedBody.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import LocalizedDate from '../../components/LocalizedDate.astro';
import { getCollection, render } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import PaperFigure, { hasPaperFigure } from '../../components/publications/detail/PaperFigure.tsx';
import CiteButton from '../../components/publications/shared/CiteButton.tsx';
import { getAuthorMap, resolveAuthors } from '../../lib/people';
import { paperUrl, doiOf, extraLinks } from '../../lib/pubs';
import { citationKind } from '../../lib/bibtex';

import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({
    params: { id: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { data, id } = pub;
const { Content } = await render(pub);
const authorMap = await getAuthorMap();
const authorEntries = resolveAuthors(data.authors, authorMap, data.ru?.authors);


const citable = {
  id,
  title: data.title,
  authors: data.authors,
  dateISO: data.date.toISOString(),
  venue: data.venue,
  type: data.type,
  tag: data.tag,
  arxiv: data.arxiv,
  doi: doiOf(data),
};

const showFigure = hasPaperFigure(id);
const paper = paperUrl(data);
const kind = citationKind(data);
const bibtexPath = `/publications/${id}.bib`;
---

<DetailLayout
  active="pubs"
  title={`${data.title} · OOAARG`}
  description={data.summary}
  heading={data.title}
  headingRu={data.ru?.title}
  titleRu={`${data.ru?.title ?? data.title} · ООИПИГ`}
  descriptionRu={data.ru?.summary}
>
  <Fragment slot="head">
    {data.type !== 'code' && data.type !== 'talk' && (
      <>
        <meta name="citation_title" content={data.title} />
        {data.authors.map((author) => <meta name="citation_author" content={author} />)}
        <meta name="citation_publication_date" content={data.date.toISOString().slice(0, 10).replaceAll('-', '/')} />
        {kind === 'article' && <meta name="citation_journal_title" content={data.venue} />}
        {kind === 'inproceedings' && <meta name="citation_conference_title" content={data.venue} />}
        {citable.doi && <meta name="citation_doi" content={citable.doi} />}
      </>
    )}
    <link rel="alternate" type="application/x-bibtex" href={bibtexPath} title="BibTeX citation" />
  </Fragment>

  <Fragment slot="breadcrumb">
    <a href="/publications" data-i18n="Publications">Publications</a> <span>/</span> <a href={`/publications?venue=${encodeURIComponent(data.venue)}`}><LocalizedText en={data.venue} ru={data.ru?.venue} /></a>{' '}<span>/</span>{' '}
    <LocalizedText en={authorEntries[0].name} ru={authorEntries[0].ru} /> <span data-i18n="et al.">et al.</span>
  </Fragment>

  <Fragment slot="badges">
    <span class="detail-type">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M14 2H6C5.46957 2 4.96086 2.21072 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8M14 2C14.3166 1.99949 14.6301 2.06161 14.9225 2.18277C15.215 2.30394 15.4806 2.48176 15.704 2.706L19.292 6.294C19.5168 6.51751 19.6952 6.78335 19.8167 7.07616C19.9382 7.36898 20.0005 7.68297 20 8M14 2V7C14 7.26522 14.1054 7.51957 14.2929 7.70711C14.4804 7.89464 14.7348 8 15 8L20 8M10 9H8M16 13H8M16 17H8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
      <span data-i18n={data.type === 'paper' && data.tag === 'Preprint' ? 'Preprint' : data.type}>{data.type === 'paper' && data.tag === 'Preprint' ? 'Preprint' : data.type}</span>
    </span>
  </Fragment>

  <p class="authors" slot="byline">
    {authorEntries.map((a, i) => (
      <>
        {a.id ? (
          <a class="author-link" href={`/about/${a.id}`}><strong><LocalizedText en={a.name} ru={a.ru} /></strong></a>
        ) : (
          <strong><LocalizedText en={a.name} ru={a.ru} /></strong>
        )}
        {i < authorEntries.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>

  <Fragment slot="actions">
    {paper && (
      <a class="btn btn-accent" href={paper} target="_blank" rel="noopener" data-i18n="Paper">Paper</a>
    )}
    {data.arxiv && (
      <a
        class={paper ? 'btn' : 'btn btn-primary'}
        href={`https://arxiv.org/abs/${data.arxiv}`}
        target="_blank"
        rel="noopener"
      >
        arXiv:{data.arxiv}
      </a>
    )}
    {data.pdf && <a class="btn" href={data.pdf} target="_blank" rel="noopener">PDF</a>}
    {data.github && <a class="btn" href={data.github} target="_blank" rel="noopener">GitHub</a>}
    {extraLinks(data).map((l) => (
      <a class="btn" href={l.url} target="_blank" rel="noopener"><LocalizedText en={l.label} ru={data.ru?.links?.[l.label]} /></a>
    ))}
    <CiteButton client:visible pub={citable} size="md" label="Cite" />
    <a class="btn" href={bibtexPath} download={`${id}.bib`}><svg class="publication-action-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M12 17V3M18 11L12 17L6 11M19 21H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Download .bib">Download .bib</span></a>
  </Fragment>

  {showFigure && (
    <div class="pub-figure" slot="figure">
      <PaperFigure id={id} />
    </div>
  )}

  <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody>

  <Fragment slot="aside">
    <div class="group">
      <h2 class="aside-label"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M8 2V6M16 2V6M3 10H21M5 4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Published">Published</span></h2>
      <p class="mono" style="color: var(--fg);"><LocalizedDate date={data.date} /></p>
    </div>
    <div class="group">
      <h2 class="aside-label"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M16 21V19C16 17.9391 15.5786 16.9217 14.8284 16.1716C14.0783 15.4214 13.0609 15 12 15H6C4.93913 15 3.92172 15.4214 3.17157 16.1716C2.42143 16.9217 2 17.9391 2 19V21M16 3.12793C16.8578 3.3503 17.6174 3.85119 18.1597 4.55199C18.702 5.25279 18.9962 6.11382 18.9962 6.99993C18.9962 7.88604 18.702 8.74707 18.1597 9.44787C17.6174 10.1487 16.8578 10.6496 16 10.8719M22 20.9999V18.9999C21.9993 18.1136 21.7044 17.2527 21.1614 16.5522C20.6184 15.8517 19.8581 15.3515 19 15.1299M13 7C13 9.20914 11.2091 11 9 11C6.79086 11 5 9.20914 5 7C5 4.79086 6.79086 3 9 3C11.2091 3 13 4.79086 13 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Venue">Venue</span></h2>
      <p><a class="venue-link" href={`/publications?venue=${encodeURIComponent(data.venue)}`}><LocalizedText en={data.venue} ru={data.ru?.venue} /></a></p>
    </div>
    {data.tags.length > 0 && (
      <div class="group">
        <h2 class="aside-label"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M7.5 8C7.77614 8 8 7.77614 8 7.5C8 7.22386 7.77614 7 7.5 7C7.22386 7 7 7.22386 7 7.5C7 7.77614 7.22386 8 7.5 8Z" fill="currentColor"/>
<path d="M12.586 2.586C12.211 2.2109 11.7024 2.00011 11.172 2H4C3.46957 2 2.96086 2.21071 2.58579 2.58579C2.21071 2.96086 2 3.46957 2 4V11.172C2.00011 11.7024 2.2109 12.211 2.586 12.586L11.29 21.29C11.7445 21.7416 12.3592 21.9951 13 21.9951C13.6408 21.9951 14.2555 21.7416 14.71 21.29L21.29 14.71C21.7416 14.2555 21.9951 13.6408 21.9951 13C21.9951 12.3592 21.7416 11.7445 21.29 11.29L12.586 2.586Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M7.5 8C7.77614 8 8 7.77614 8 7.5C8 7.22386 7.77614 7 7.5 7C7.22386 7 7 7.22386 7 7.5C7 7.77614 7.22386 8 7.5 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Keywords">Keywords</span></h2>
        <p class="publication-keywords">
          {data.tags.map((t, i) => (<><a href={`/publications?tag=${encodeURIComponent(t)}`}><LocalizedText en={t} ru={data.ru?.tags?.[t]} /></a>{i < data.tags.length - 1 ? ", " : ""}</>))}
        </p>
      </div>
    )}
  </Fragment>
</DetailLayout>
