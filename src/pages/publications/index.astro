---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import SearchIndex from '../../components/publications/search/SearchIndex.tsx';
import type { IndexedPub } from '../../components/publications/search/SearchIndex.tsx';
import { getAuthorMap, getStaffAuthorNames, resolveAuthors } from '../../lib/people';
import { sortByDateDesc } from '../../lib/pubs';

const all = (await getCollection('publications')).sort(sortByDateDesc);
const authorMap = await getAuthorMap();
const staffAuthorNames = await getStaffAuthorNames();

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

const pubs: IndexedPub[] = all.map((p) => ({
  id: p.id,
  title: p.data.title,
  authors: p.data.authors,
  authorLinks: resolveAuthors(p.data.authors, authorMap).map((author) => ({
    ...author,
    staff: staffAuthorNames.has(author.name),
  })),
  date: fmt(p.data.date),
  year: p.data.date.getFullYear(),
  venue: p.data.venue,
  type: p.data.type,
  area: p.data.area,
  tags: p.data.tags,
  abstract: p.data.summary,
}));
---

<Site
  active="pubs"
  title="Publications · OOAARG"
  description="Search and filter every OOAARG publication by topic, venue, year, author, or type."
>
  <section class="pubs-hero">
    <div class="container">
      <h1>Publications</h1>
      <p>
        Filter by area, type, author, year, or venue — or just type a few words.
      </p>
    </div>
  </section>

  <div class="container">
    <h2 class="kicker" style="margin-bottom: 8px;">Search the corpus</h2>
    <SearchIndex client:load pubs={pubs} />
  </div>
</Site>
