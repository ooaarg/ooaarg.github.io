---
import { localeFromUrl, translate } from '../../lib/i18n';
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import SearchIndex from '../../components/publications/search/SearchIndex.tsx';
import type { IndexedPub } from '../../components/publications/search/SearchIndex.tsx';
import { getAuthorMap, getStaffAuthorNames, resolveAuthors } from '../../lib/people';
import { sortByDateDesc } from '../../lib/pubs';

const all = (await getCollection('publications')).sort(sortByDateDesc);
const authorMap = await getAuthorMap();
const staffAuthorNames = await getStaffAuthorNames();


const pubs: IndexedPub[] = all.map((p) => ({
  id: p.id,
  title: p.data.title,
  ru: p.data.ru ? { title: p.data.ru.title, summary: p.data.ru.summary, venue: p.data.ru.venue, tags: p.data.ru.tags } : undefined,
  authors: p.data.authors,
  authorLinks: resolveAuthors(p.data.authors, authorMap, p.data.ru?.authors).map((author) => ({
    ...author,
    staff: staffAuthorNames.has(author.name),
  })),
  dateISO: p.data.date.toISOString(),
  year: p.data.date.getUTCFullYear(),
  venue: p.data.venue,
  type: p.data.type,
  area: p.data.area,
  tags: p.data.tags,
  abstract: p.data.summary,
}));
const locale = localeFromUrl(Astro.url);
---

<Site titleRu="Публикации · OOAARG" descriptionRu="Поиск публикаций OOAARG по теме, изданию, году, автору и типу."
  active="pubs"
  title="Publications · OOAARG"
  description="Search and filter every OOAARG publication by topic, venue, year, author, or type."
>
  <script slot="head" is:inline>
    (() => {
      const searchParams = new URLSearchParams(location.search);
      if (searchParams.get('sort') === 'oldest' || ['q', 'type', 'area', 'venue', 'year', 'author', 'tag'].some((key) => searchParams.getAll(key).some(Boolean))) {
        document.documentElement.setAttribute('data-publication-search-pending', '');
        let pendingTransition;
        const reveal = () => {
          document.documentElement.removeAttribute('data-publication-search-pending');
          pendingTransition?.skipTransition();
        };
        // A failed island download must not leave the static catalogue hidden.
        const fallback = window.setTimeout(reveal, 3000);
        window.addEventListener('pagereveal', (event) => {
          pendingTransition = event.viewTransition;
          if (!document.documentElement.hasAttribute('data-publication-search-pending') || document.querySelector('.publication-search[data-search-ready="true"]')) pendingTransition?.skipTransition();
        });
        document.addEventListener('publication-search-ready', () => {
          window.clearTimeout(fallback);
          reveal();
        }, { once: true });
      }
    })();
  </script>
  <section class="pubs-hero">
    <div class="container">
      <h1>{translate('Publications', locale)}</h1>
      <p>{translate('Filter by area, type, author, year, or venue. Or just type a few words.', locale)}</p>
    </div>
  </section>

  <div class="container">
    <h2 class="search-heading">{translate('Search publications', locale)}</h2>
    <SearchIndex initialLocale={locale} client:load pubs={pubs} />
  </div>
</Site>
