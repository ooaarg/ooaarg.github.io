---
import LocalizedBody from '../../components/LocalizedBody.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import LocalizedDate from '../../components/LocalizedDate.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import DetailLayout from '../../layouts/DetailLayout.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

---

<DetailLayout
  active="blog"
  title={`${data.title} · OOAARG`}
  description={data.summary}
  heading={data.title}
  headingRu={data.ru?.title}
  titleRu={`${data.ru?.title ?? data.title} · ООИПИГ`}
  descriptionRu={data.ru?.summary}
>
  <Fragment slot="breadcrumb">
    <a href="/blog" data-i18n="Blog">Blog</a> <span>/</span> <span data-i18n="News">News</span>
  </Fragment>

  <Fragment slot="badges">
    <span class="detail-type">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 7h4v4H7ZM14 7h3m-3 4h3M7 15h10M7 18h10" /></svg>
      <span data-i18n="News">News</span>
    </span>
  </Fragment>

  <p class="authors" slot="byline" style="max-width: 60ch;"><LocalizedText en={data.summary} ru={data.ru?.summary} /></p>

  {data.href && (
    <a
      slot="actions"
      class="btn btn-accent"
      href={data.href}
      target="_blank"
      rel="noopener"
    >
      <span data-i18n="Conference link">Conference link</span>
    </a>
  )}

  {data.image && (
    <figure slot="figure" class="news-hero-figure">
      <Image src={data.image} alt={data.imageAlt} data-content-alt-en={data.imageAlt} data-content-alt-ru={data.ru?.imageAlt} loading="eager" />
    </figure>
  )}

  <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody>

  <Fragment slot="aside">
    <div class="group">
      <h2 class="aside-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 11h18" /></svg><span data-i18n="Posted">Posted</span></h2>
      <p class="mono" style="color: var(--fg);"><LocalizedDate date={data.date} /></p>
    </div>
    <div class="group">
      <h2 class="aside-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h8l10 10-8 8L3 11V3Z" /><circle cx="7.5" cy="7.5" r="1" /></svg><span data-i18n="Category">Category</span></h2>
      <p><span data-i18n="News">News</span></p>
    </div>
  </Fragment>
</DetailLayout>

<style>
  .news-hero-figure {
    margin: 56px 0 0;
    max-width: 720px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }
  .news-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .news-hero-figure {
      margin-top: 32px;
    }
  }
</style>
