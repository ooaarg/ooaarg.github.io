---
import LocalizedBody from '../../components/LocalizedBody.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import LocalizedDate from '../../components/LocalizedDate.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import DetailLayout from '../../layouts/DetailLayout.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

---

<DetailLayout
  active="blog"
  title={`${data.title} · OOAARG`}
  description={data.summary}
  heading={data.title}
  headingRu={data.ru?.title}
  titleRu={`${data.ru?.title ?? data.title} · OOAARG`}
  descriptionRu={data.ru?.summary}
>
  <Fragment slot="breadcrumb">
    <a href="/blog" data-i18n="Blog">Blog</a> <span>/</span> <span data-i18n="News">News</span>
  </Fragment>

  <Fragment slot="badges">
    <span class="detail-type">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M14 2H6C5.46957 2 4.96086 2.21072 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8M14 2C14.3166 1.99949 14.6301 2.06161 14.9225 2.18277C15.215 2.30394 15.4806 2.48176 15.704 2.706L19.292 6.294C19.5168 6.51751 19.6952 6.78335 19.8167 7.07616C19.9382 7.36898 20.0005 7.68297 20 8M14 2V7C14 7.26522 14.1054 7.51957 14.2929 7.70711C14.4804 7.89464 14.7348 8 15 8L20 8M10 9H8M16 13H8M16 17H8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg>
      <span data-i18n="News">News</span>
    </span>
  </Fragment>

  <p class="authors" slot="byline" style="max-width: 60ch;"><LocalizedText en={data.summary} ru={data.ru?.summary} /></p>

  {data.href && (
    <a
      slot="actions"
      class="btn btn-accent"
      href={data.href}
      target="_blank"
      rel="noopener"
    >
      <span data-i18n="Conference link">Conference link</span>
    </a>
  )}

  {data.image && (
    <figure slot="figure" class="news-hero-figure">
      <Image src={data.image} alt={data.imageAlt} data-content-alt-en={data.imageAlt} data-content-alt-ru={data.ru?.imageAlt} loading="eager" />
    </figure>
  )}

  <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody>

  <Fragment slot="aside">
    <div class="group">
      <h2 class="aside-label"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M8 2V6M16 2V6M3 10H21M5 4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Posted">Posted</span></h2>
      <p class="mono" style="color: var(--fg);"><LocalizedDate date={data.date} /></p>
    </div>
    <div class="group">
      <h2 class="aside-label"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none"><path d="M7.5 8C7.77614 8 8 7.77614 8 7.5C8 7.22386 7.77614 7 7.5 7C7.22386 7 7 7.22386 7 7.5C7 7.77614 7.22386 8 7.5 8Z" fill="currentColor"/>
<path d="M12.586 2.586C12.211 2.2109 11.7024 2.00011 11.172 2H4C3.46957 2 2.96086 2.21071 2.58579 2.58579C2.21071 2.96086 2 3.46957 2 4V11.172C2.00011 11.7024 2.2109 12.211 2.586 12.586L11.29 21.29C11.7445 21.7416 12.3592 21.9951 13 21.9951C13.6408 21.9951 14.2555 21.7416 14.71 21.29L21.29 14.71C21.7416 14.2555 21.9951 13.6408 21.9951 13C21.9951 12.3592 21.7416 11.7445 21.29 11.29L12.586 2.586Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M7.5 8C7.77614 8 8 7.77614 8 7.5C8 7.22386 7.77614 7 7.5 7C7.22386 7 7 7.22386 7 7.5C7 7.77614 7.22386 8 7.5 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg><span data-i18n="Category">Category</span></h2>
      <p><span data-i18n="News">News</span></p>
    </div>
  </Fragment>
</DetailLayout>

<style>
  .news-hero-figure {
    margin: 56px 0 0;
    max-width: 720px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }
  .news-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .news-hero-figure {
      margin-top: 32px;
    }
  }
</style>
