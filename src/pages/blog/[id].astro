---
import BackLink from '../../components/shared/BackLink.astro';
import { localeFromUrl, translate } from '../../lib/i18n';
import { contentText } from '../../lib/content-language';
import LocalizedBody from '../../components/LocalizedBody.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import LocalizedDate from '../../components/LocalizedDate.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import DetailLayout from '../../layouts/DetailLayout.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

const locale = localeFromUrl(Astro.url);
---

<DetailLayout
  active="blog"
  title={`${data.title} · OOAARG`}
  description={data.summary}
  heading={data.title}
  headingRu={data.ru?.title}
  titleRu={`${data.ru?.title ?? data.title} · OOAARG`}
  descriptionRu={data.ru?.summary}
>
  <BackLink slot="breadcrumb" href="/blog" label="Blog" />

  <Fragment slot="badges">
    <span class="news-date"><LocalizedDate date={data.date} /></span>
  </Fragment>

  <p class="authors" slot="byline" style="max-width: 60ch;"><LocalizedText en={data.summary} ru={data.ru?.summary} /></p>

  {data.href && (
    <a
      slot="actions"
      class="news-conference-link"
      href={data.href}
      target="_blank"
      rel="noopener"
      aria-label={`${translate('Conference', locale)} — ${translate('Opens in new tab', locale)}`}
    >
      <span>{translate('Conference', locale)}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M17 17V7H7M17 7L7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  )}

  {data.image && (
    <figure slot="figure" class="news-hero-figure">
      <Image src={data.image} alt={contentText(data.imageAlt, data.ru?.imageAlt, locale)} width={1440} format="webp" sizes="(max-width: 760px) calc(100vw - 40px), 720px" loading="eager" />
    </figure>
  )}

  <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody>

</DetailLayout>

<style>
  .news-hero-figure {
    margin: 32px 0 0;
    max-width: 720px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }
  .news-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .news-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .news-conference-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .news-conference-link:hover {
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .news-hero-figure {
      margin-top: 24px;
    }
  }
</style>
