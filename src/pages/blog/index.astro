---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import NewsTile from '../../components/publications/cards/NewsTile.astro';
import YearFilter from '../../components/publications/list/YearFilter.tsx';
import { packBento } from '../../lib/pubs';

import '../../styles/publications-cards.css';

const items = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const allYears = [...new Set(items.map((i) => i.data.date.getFullYear()))].sort(
  (a, b) => b - a,
);

const tiles = packBento(items, (i) => i.data.span);
---

<Site titleRu="Блог · ООИПИГ" descriptionRu="Новости исследовательской группы ООИПИГ."
  active="blog"
  title="Blog · OOAARG"
  description="News from the OOAARG research group."
>
  <section class="pubs-hero">
    <div class="container">
      <h1 data-i18n="Latest news">Latest news</h1>
      <p data-i18n="News and updates from our research group.">
        News and updates from our research group.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="pubs-toolbar">
      <h2 class="kicker" style="margin-right: 4px;" data-i18n="Filter">Filter</h2>
      <YearFilter client:load years={allYears} total={items.length} />
      <a class="btn btn-sm" href="/publications" data-i18n="Publications →">Publications →</a>
    </div>

    <div class="bento">
      {tiles.map(({ item, span }) => <NewsTile item={item} span={span} />)}
    </div>
  </div>
</Site>
