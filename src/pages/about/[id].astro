---
import { localeFromUrl, translate, localizedHref } from '../../lib/i18n';
import LocalizedBody from '../../components/LocalizedBody.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Avatar from '../../components/people/Avatar.astro';
import BackLink from '../../components/shared/BackLink.astro';
import PublicationQuickView from '../../components/publications/shared/PublicationQuickView.astro';
import {
  getAuthorMap,
  getPersonPubs,
  groupPubsByYear,
  resolveAuthors,
} from '../../lib/people';

import '../../styles/people.css';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { id: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { data } = person;
const { Content } = await render(person);

// Partners are external collaborators, not OOAARG members, so their detail
// page skips the group's publication list.
const showPubs = data.group !== 'partner';
const allPubs = await getCollection('publications');
const personPubs = showPubs ? getPersonPubs(person, allPubs) : [];
const yearGroups = groupPubsByYear(personPubs);
const authorMap = await getAuthorMap();

const hasBio = (person.body ?? '').trim().length > 0;
const isGroupMember = ['faculty', 'postdoc', 'phd'].includes(data.group);
const organization = data.org ?? (isGroupMember ? 'OOAARG' : undefined);

const linkRow = [
  data.links.website && { label: 'Website', href: data.links.website },
  data.links.scholar && { label: 'Google Scholar', href: data.links.scholar },
  data.links.orcid && { label: 'ORCID', href: data.links.orcid },
  data.links.dblp && { label: 'DBLP', href: data.links.dblp },
  data.links.researchgate && { label: 'ResearchGate', href: data.links.researchgate },
  data.links.github && { label: 'GitHub', href: data.links.github },
  data.links.cv && { label: 'CV', href: data.links.cv },
  ...data.links.other.map((l) => ({ label: l.label, href: l.url })),
  data.email && { label: data.email, href: `mailto:${data.email}` },
].filter(Boolean) as Array<{ label: string; href: string }>;

const locale = localeFromUrl(Astro.url);
---

<Site
  active="about"
  title={`${data.name} · OOAARG`}
  titleRu={`${data.ru?.name ?? data.name} · OOAARG`}
  descriptionRu={data.ru?.topic}
  description={`${data.role}: ${data.topic}`}
>
  <section class="person-detail">
    <div class="container">
      <BackLink href="/about" label="About" />

      <div class="person-detail-hero">
        <Avatar person={person} />
        <div>
          <div class="role"><LocalizedText en={data.role} ru={data.ru?.role} /></div>
          <h1 style="margin-top: 8px;"><LocalizedText en={data.name} ru={data.ru?.name} /></h1>
          <p class="topic" style="margin-top: 12px; font-size: 18px; max-width: 56ch;">
            <LocalizedText en={data.topic} ru={data.ru?.topic} />
          </p>
          {organization && <p class="person-organization"><LocalizedText en={organization} ru={data.ru?.org} /></p>}
          {data.office && (
            <p class="mono" style="margin-top: 12px; font-size: 13px; color: var(--fg-muted);">
              <LocalizedText en={data.office} ru={data.ru?.office} />
            </p>
          )}
          {linkRow.length > 0 && (
            <div class="person-links">
              {linkRow.map((l) => (
                <a
                  class="person-resource-link"
                  href={localizedHref(l.href, locale)}
                  target={l.href.startsWith('http') ? '_blank' : undefined}
                  rel={l.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {l.href.startsWith('mailto:') && (<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
<path d="M22 7L13.009 12.727C12.7039 12.9042 12.3573 12.9976 12.0045 12.9976C11.6517 12.9976 11.3051 12.9042 11 12.727L2 7M4 4H20C21.1046 4 22 4.89543 22 6V18C22 19.1046 21.1046 20 20 20H4C2.89543 20 2 19.1046 2 18V6C2 4.89543 2.89543 4 4 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>)}
                  <LocalizedText en={l.label} ru={data.ru?.links?.[l.label]} />
                  {l.href.startsWith('http') && (<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
<path d="M17 17V7H7M17 7L7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>)}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <section class="person-section person-bio-section">
        <h2 class="people-section-title">{translate('About the researcher', locale)}</h2>
        <div class="person-bio">
          {hasBio || data.ru?.body ? <LocalizedBody ru={data.ru?.body}><Content /></LocalizedBody> : <p><span>{translate('Bio coming soon.', locale)}</span></p>}
        </div>
      </section>

      {showPubs && (
      <section class="person-section">
        <h2 class="people-section-title">{translate('Publications', locale)}</h2>
        {yearGroups.length === 0 ? (
          <p class="person-pubs-empty"><span>{translate('No publications listed yet.', locale)}</span></p>
        ) : (
          <div class="person-pubs">
            {yearGroups.map(([year, pubs]) => (
              <div class="person-pubs-year">
                <p class="person-pubs-year-label">{year}</p>
                <ul class="pub-list">
                  {pubs.map((p) => (
                    <PublicationQuickView
                      minimalActions
                      publication={p}
                      authors={resolveAuthors(p.data.authors, authorMap, p.data.ru?.authors)}
                      selfName={data.name}
                    />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
      )}
    </div>
  </section>
</Site>
