---
import { localeFromUrl, translate, localizedHref } from '../lib/i18n';
import LocalizedText from '../components/LocalizedText.astro';
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import PersonCard from '../components/people/PersonCard.astro';
import PersonLead from '../components/people/PersonLead.astro';
import groupSymbol from '../assets/ooaarg-symbol.svg?raw';

import '../styles/people.css';

interface Props {
  topicExamples?: string[];
}
const { topicExamples } = Astro.props;
const all = await getCollection('people');
const previewPerson = (person: typeof all[number], index: number) => topicExamples?.length
  ? { ...person, data: { ...person.data, topic: topicExamples[index % topicExamples.length], ru: person.data.ru ? { ...person.data.ru, topic: undefined } : undefined } }
  : person;
const byOrder = (a: typeof all[number], b: typeof all[number]) =>
  a.data.order - b.data.order;

const lead = all.find((p) => p.data.group === 'faculty');

const STAFF_RANK: Record<string, number> = { postdoc: 0, phd: 1, faculty: 2 };
const staff = all
  .filter((p) => p.data.group in STAFF_RANK && p.id !== lead?.id)
  .sort((a, b) => {
    const r = (STAFF_RANK[a.data.group] ?? 9) - (STAFF_RANK[b.data.group] ?? 9);
    return r !== 0 ? r : byOrder(a, b);
  });

const partners = all.filter((p) => p.data.group === 'partner').sort(byOrder);

const partnersByOrg = [
  ...partners
    .reduce((acc, p) => {
      const org = p.data.org ?? 'Other';
      (acc.get(org) ?? acc.set(org, []).get(org)!).push(p);
      return acc;
    }, new Map<string, typeof partners>())
    .entries(),
].sort((a, b) => a[1][0].data.order - b[1][0].data.order);

const alumni = all.filter((p) => p.data.group === 'alumni').sort(byOrder);
const locale = localeFromUrl(Astro.url);
---

<Site titleRu="О группе · OOAARG" descriptionRu="Исследовательская группа по онлайн-оптимизации и её приложениям: руководитель, команда и выпускники."
  active="about"
  title="About · OOAARG"
  description="Online Optimization and Applications Research Group: lead, staff, and alumni."
>
  <slot name="preview-controls" />
  <section class="people-hero">
    <div class="container about-intro">
      <div class="about-symbol" data-symbol-spin aria-hidden="true" set:html={groupSymbol} />
      <div>
        <h1 class="about-title"><LocalizedText en="Online Optimization and Applications Research Group" ru="Исследовательская группа по онлайн-оптимизации и её приложениям" /></h1>
        <p class="about-summary">{translate('A research group studying decisions under uncertainty. Theory, algorithms, and the messy real-world problems that motivate both.', locale)}</p>
      </div>
    </div>
  </section>

  {lead && (
    <section class="people-section">
      <div class="container">
        <h2 class="people-section-title">{translate('Lead', locale)}</h2>
        <PersonLead person={lead} />
      </div>
    </section>
  )}

  {staff.length > 0 && (
    <section class="people-section" id="people">
      <div class="container">
        <h2 class="people-section-title">{translate('Staff', locale)}</h2>
        <div class="people-grid">
          {staff.map((p, index) => (
            <a class="person-card-link" href={localizedHref(`/about/${p.id}`, locale)}>
              <PersonCard person={previewPerson(p, index)} />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {partners.length > 0 && (
    <section class="people-section">
      <div class="container">
        <h2 class="people-section-title">{translate('Partners', locale)}</h2>
        <div class="partner-orgs">
          {partnersByOrg.map(([org, members]) => (
            <div class="partner-org">
              <div class="partner-org-label">
                <span class="partner-org-name"><LocalizedText en={org} ru={members.find((p) => p.data.ru?.org)?.data.ru?.org} /></span>
              </div>
              <div class="people-grid">
                {members.map((p, index) => (
                  <a class="person-card-link" href={localizedHref(`/about/${p.id}`, locale)}>
                    <PersonCard person={previewPerson(p, index)} />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {alumni.length > 0 && (
    <section class="people-section">
      <div class="container">
        <h2 class="people-section-title">{translate('Alumni', locale)}</h2>
        <div class="people-grid">
          {alumni.map((p, index) => (
            <a class="person-card-link" href={localizedHref(`/about/${p.id}`, locale)}>
              <PersonCard person={previewPerson(p, index)} />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Site>
