---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import FeaturedHero from '../components/home/FeaturedHero.tsx';
import AreasOfResearch from '../components/home/AreasOfResearch.astro';
import LatestPubs from '../components/home/LatestPubs.astro';
import JoinStrip from '../components/home/JoinStrip.astro';
import { featuredCarousel, paperUrl } from '../lib/pubs';

import '../styles/home.css';

const pubs = await getCollection('publications');

const slides = featuredCarousel(pubs).map((p) => ({
  id: p.id,
  ru: {
    title: p.data.ru?.title,
    summary: p.data.ru?.heroSummary ?? p.data.ru?.summary,
    venue: p.data.ru?.venue,
    keywords: p.data.ru?.tags,
  },
  title: p.data.title,
  venue: p.data.venue,
  keywords: p.data.tags.slice(0, 4),
  summary: p.data.heroSummary ?? p.data.summary,
  paper: paperUrl(p.data),
  arxiv: p.data.arxiv,
  github: p.data.github,
}));
---

<Site titleRu="Исследовательская Группа Онлайн Оптимизация И Приложения" descriptionRu="Исследовательская группа по онлайн-оптимизации, онлайн-обучению, многоруким бандитам и оптимизации СУБД. Теоретические гарантии регрета и практическое применение."
  active="home"
  title="OOAARG — Online Optimization And Applications Research Group"
  description="A research group on online optimization, online learning, bandits, and DBMS optimization. Provable regret guarantees, practical deployment."
>
  <FeaturedHero client:load slides={slides} />

  <section class="section section-after-hero">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 data-i18n="What we work on">What we work on</h2>
        </div>
      </div>
      <AreasOfResearch pubs={pubs} />
    </div>
  </section>

  <LatestPubs />
  <JoinStrip />
</Site>
