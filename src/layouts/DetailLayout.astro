---
import LocalizedText from '../components/LocalizedText.astro';
import Site from './Site.astro';

import '../styles/publications-detail.css';

interface Props {
  active: 'pubs' | 'blog';
  title: string;
  description: string;
  heading: string;
  headingRu?: string;
  titleRu?: string;
  descriptionRu?: string;
}

const { active, title, description, heading, headingRu, titleRu, descriptionRu } = Astro.props;
const hasActions = Astro.slots.has('actions');
const hasFigure = Astro.slots.has('figure');
---

<Site active={active} title={title} description={description} titleRu={titleRu} descriptionRu={descriptionRu}>
  <slot name="head" slot="head" />
  <section class={`pub-detail${active === 'blog' ? ' is-news' : ''}`}>
    <div class="container">
      <div class="breadcrumb">
        <slot name="breadcrumb" />
      </div>

      <div class="detail-layout">
        <div class="detail-main">
          <div class="badge-row">
            <slot name="badges" />
          </div>

          <h1 lang="en" style="view-transition-name: hero-title;"><LocalizedText en={heading} ru={headingRu} /></h1>
          <slot name="byline" />

          {hasActions && (
            <div class="actions">
              <slot name="actions" />
            </div>
          )}

          {hasFigure && <slot name="figure" />}

          <div class="pub-content">
            <article lang="en">
              <slot />
            </article>
          </div>
        </div>
        <aside class="pub-aside">
          <slot name="aside" />
        </aside>
      </div>
    </div>
  </section>
</Site>
