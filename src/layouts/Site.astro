---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';

import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/components.css';
import '../styles/kinetic-logo.css';

interface Props {
  title?: string;
  titleRu?: string;
  descriptionRu?: string;
  description?: string;
  active?: 'home' | 'blog' | 'pubs' | 'about';
}

const { title, description, active, titleRu, descriptionRu } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <SeoHead title={title} description={description} titleRu={titleRu} descriptionRu={descriptionRu} />
    <slot name="head" />

    {/* Inline theme init — runs BEFORE paint to avoid dark↔light flash. */}
    <script is:inline>
      (function () {
        // Resolve the language before any body content can paint. Translation
        // runs in the bundled language controller once the document is parsed.
        var locale = new URLSearchParams(location.search).get('lang');
        if (locale !== 'en' && locale !== 'ru') {
          try { locale = localStorage.getItem('ooaarg-language'); } catch (_) {}
        }
        if (locale === 'ru') {
          document.documentElement.lang = 'ru';
          document.documentElement.setAttribute('data-language-pending', '');
          // A failed module request must never leave the static page blank.
          window.setTimeout(function () {
            if (document.documentElement.hasAttribute('data-language-pending')) {
              document.documentElement.removeAttribute('data-language-pending');
              if (!document.documentElement.hasAttribute('data-language-ready')) {
                document.documentElement.lang = 'en';
              }
            }
          }, 3000);
        }
        function applyTheme() {
          try {
            var stored = localStorage.getItem('ooaarg-theme');
            document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
          } catch (_) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        }
        applyTheme();
        // A cached document may predate a theme change on another page.
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) applyTheme();
        });
        // Stale hash-route mitigation: rewrite #/foo → /foo (legacy prototype links)
        if (location.hash && location.hash.startsWith('#/')) {
          var newPath = location.hash.slice(1);
          location.replace(newPath);
        }
      })();
    </script>
    <style is:inline>
      html[data-language-pending] body { visibility: hidden; }
      html[lang="ru"][data-language-ready] astro-island[ssr] { visibility: hidden; }
    </style>
  </head>
  <body>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
