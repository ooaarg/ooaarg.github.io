---
import { localeFromUrl } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';

import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/components.css';
import '../styles/kinetic-logo.css';

interface Props {
  title?: string;
  titleRu?: string;
  descriptionRu?: string;
  description?: string;
  active?: 'home' | 'blog' | 'pubs' | 'about';
}

const locale = localeFromUrl(Astro.url);
const { title, description, active, titleRu, descriptionRu } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Keep the browser canvas themed before the shared stylesheet arrives. */}
    <style is:inline>
      html { background: #0a0a0a; color-scheme: dark; }
      html[data-theme="light"] { background: #fafaf9; color-scheme: light; }
    </style>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {locale === 'ru' && <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />}
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <SeoHead title={title} description={description} titleRu={titleRu} descriptionRu={descriptionRu} />
    <slot name="head" />

    {/* Inline theme init — runs BEFORE paint to avoid dark↔light flash. */}
    <script is:inline>
      (function () {
        // Compatibility for old shared links. Normal navigation uses static paths.
        var legacy = new URLSearchParams(location.search).get('lang');
        // Static hosts serve the generic 404 document at the missing URL.
        // Resolve its language before rendering the shared header and recovery links.
        if (document.querySelector('meta[name="ooaarg-not-found"]') &&
            !/^\/(?:en|ru)\/404\/?$/.test(location.pathname)) {
          var errorLocale = legacy === 'ru' || legacy !== 'en' && /^\/ru(?:\/|$)/.test(location.pathname) ? 'ru' : 'en';
          location.replace('/' + errorLocale + '/404/');
          return;
        }
        if (legacy === 'en' || legacy === 'ru' || !/^\/(?:en|ru)(?:\/|$)/.test(location.pathname) && location.pathname !== '/404.html') {
          var url = new URL(location.href);
          var path = url.pathname.replace(/^\/(?:en|ru)(?=\/|$)/, '') || '/';
          if (/^\/404(?:\.html)?\/?$/.test(path)) path = '/404/';
          url.pathname = (legacy === 'ru' ? '/ru' : '/en') + path;
          url.searchParams.delete('lang');
          location.replace(url.href);
        }
        function applyTheme() {
          try {
            var stored = localStorage.getItem('ooaarg-theme');
            document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
          } catch (_) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        }
        applyTheme();
        // Fragment destinations should appear at their final scroll position,
        // without blending a page snapshot captured before anchor scrolling.
        window.addEventListener('pageswap', function (event) {
          document.documentElement.removeAttribute('data-language-switch');
          if (event.viewTransition && event.activation &&
              new URL(event.activation.entry.url).pathname.split('/')[1] !== location.pathname.split('/')[1]) {
            document.documentElement.setAttribute('data-language-switch', '');
          }
          if (event.viewTransition && event.activation && new URL(event.activation.entry.url).hash && !/^\/(?:en|ru)\/publications\/?$/.test(new URL(event.activation.entry.url).pathname)) {
            event.viewTransition.skipTransition();
          }
        });
        window.addEventListener('pagereveal', function (event) {
          document.documentElement.removeAttribute('data-language-switch');
          var previousEntry = window.navigation && window.navigation.activation && window.navigation.activation.from;
          if (event.viewTransition && previousEntry &&
              new URL(previousEntry.url).pathname.split('/')[1] !== location.pathname.split('/')[1]) {
            document.documentElement.setAttribute('data-language-switch', '');
          }
          if (event.viewTransition && location.hash && !document.documentElement.hasAttribute('data-publication-search-pending')) event.viewTransition.skipTransition();
        });
        // A cached document may predate a theme change on another page.
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) applyTheme();
        });
        // Stale hash-route mitigation: rewrite #/foo → /foo (legacy prototype links)
        if (location.hash && location.hash.startsWith('#/')) {
          var newPath = location.hash.slice(1);
          location.replace(newPath);
        }
      })();
    </script>
  </head>
  <body>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
